{
	$schema: "https://docs.renovatebot.com/renovate-schema.json",
	description: "Default config I like to use everywhere",
	extends: [
		"config:best-practices",
		":disableRateLimiting",
		":semanticCommits",
		":separatePatchReleases",
		":automergeBranch",
		":pinDependencies", // I want to pin all deps, not just dev ones
		"docker:enableMajor",
		"github>jloh/renovate-config:autoMerge.json5",
	],
	timezone: "Australia/Hobart",
	dependencyDashboardTitle: "🤖 Renovate Dashboard",
	suppressNotifications: ["prIgnoreNotification"],
  packageRules:
    {
      "description": "Renovate still defaults to search.devbox.sh, whose index stopped at 2026-08-27 (jetify-com/devbox#2965)",
      "matchDatasources": ["devbox"],
      "registryUrls": ["https://www.nixsearch.com/v2/"]
    }
}
